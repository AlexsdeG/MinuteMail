# Database Configuration (Prisma)
# Use a single DATABASE_URL instead of individual postgres variables
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mail_service"

# Server Configuration
PORT=3010
SMTP_PORT=2525
DOMAIN=your-email-domain

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Configuration
JWT_SECRET=super_secret_key

# Application Configuration
CLIENT_URL=your-client-url
REGISTER=false

# Example DATABASE_URL formats:
# Local PostgreSQL: postgresql://user:password@localhost:5432/database
# Remote PostgreSQL: postgresql://user:password@host.com:5432/database
# Docker PostgreSQL: postgresql://postgres:postgres@postgres:5432/mail_service
