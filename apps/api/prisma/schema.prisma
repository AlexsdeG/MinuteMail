// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

// User model - represents a registered user of the mail service
model User {
  id            String     @id @default(uuid())
  email         String     @unique
  password      String
  isMasterAdmin Boolean    @default(false)  // First user becomes master admin
  emailVerified Boolean    @default(false)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  // Relations
  aliases              Alias[]
  verificationTokens   EmailVerificationToken[]
}

// Invite token for registration when REGISTER=false
model InviteToken {
  id        String    @id @default(uuid())
  token     String    @unique
  email     String?   // Optional: restrict to specific email
  expiresAt DateTime
  usedAt    DateTime?
  createdBy String    // Master admin user ID
  createdAt DateTime  @default(now())

  @@index([token])
  @@index([expiresAt])
}

// Email verification token for verifying user email addresses
model EmailVerificationToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
  @@index([userId])
}

// Alias model - represents a temporary email address
model Alias {
  id        String     @id @default(uuid())
  address   String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  expiresAt DateTime
  isActive  Boolean    @default(true)
  isPaused  Boolean    @default(false)  // Drop incoming emails when true

  // Foreign key to user (optional - can be anonymous)
  userId    String?
  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Relations
  emails    Email[]

  @@index([userId])
  @@index([address])
  @@index([expiresAt])
}

// Email model - represents a received email
model Email {
  id        String    @id @default(uuid())
  sender    String
  subject   String?
  bodyText  String?
  bodyHtml  String?
  sizeBytes Int       @default(0)
  receivedAt DateTime  @default(now())
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  isRead    Boolean   @default(false)

  // Foreign key to alias
  aliasId   String
  alias     Alias     @relation(fields: [aliasId], references: [id], onDelete: Cascade)

  @@index([aliasId])
  @@index([receivedAt])
}

// Track used alias addresses for custom naming uniqueness
model UsedAddress {
  id        String   @id @default(uuid())
  address   String   @unique
  createdAt DateTime @default(now())

  @@index([address])
}
